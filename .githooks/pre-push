#!/usr/bin/env bash
# git pre-push hook. Rejects a push of any branch whose name breaks the branch rule. Stdin: git ref lines.
# Usage: pre-push.sh <remote> <url> < ref-lines   (git runs it; install with install-git-hooks.sh)
# Allowed: main, develop, feat|fix|chore/E012[-S03[-T05]]-short-slug
set -euo pipefail

re='^(main|develop|(feat|fix|chore)/E[0-9]{3}(-S[0-9]{2}(-T[0-9]{2})?)?-[a-z0-9-]+)$'
zero='0000000000000000000000000000000000000000'
bad=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # skip tags and others
  case "$local_sha" in "$zero"*) continue ;; esac              # skip branch deletes
  name="${remote_ref#refs/heads/}"
  if ! printf '%s\n' "$name" | grep -Eq "$re"; then
    echo "pre-push rejected: branch '$name' does not match the branch rule." >&2
    echo "Fix: rename it, for example feat/E012-S03-T05-short-slug. See standards/git.md." >&2
    bad=1
  fi
done
exit "$bad"
